# Spotify Web API credentials (Client Credentials Flow) — REQUIRED, no fallback data
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Data API v3 key — REQUIRED, no fallback data
# Create a key at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# MySQL database (optional — app runs in-memory without it)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=music_intelligence

# Server
PORT=5000
